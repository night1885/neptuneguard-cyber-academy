# Reference template only; this filename is not automatically loaded by dotenv.
# This is not an activation instruction or a replacement for instructor-mode settings.
# Supply approved real values through hosting secret settings, never in Git or chat.
# package.json still starts instructor.js; this file does not change the start command.
DISCORD_TOKEN=
GUILD_ID=

# Optional staged course runtime requires an explicit Verified role when enabled.
VERIFIED_ROLE_ID=

# Legacy index.js requires DATABASE_URL, but restoration.js does not use an academy pool.
# Do not populate or reuse an unrelated learner/progress database merely to run restoration.
DATABASE_URL=

# All feature flags remain off in this reference template.
# Flipping any flag is a separate reviewed hosting action, not authorized by this file.
CERTIFICATION_ENABLED=false
CERTIFICATION_ENROLLMENT_SUBMISSION_ENABLED=false
CERTIFICATION_APPLICATION_CLOSURE_ENABLED=false
CERTIFICATION_COURSES_ENABLED=false

# Staged restoration requires explicit owner/channel IDs; do not rely on base-loader defaults.
ACADEMY_OWNER_ID=
ACADEMY_ADMIN_CHANNEL_ID=

# Enabled certification requires its own explicit database connection; no academy-URL fallback.
CERTIFICATION_DATABASE_URL=
CERTIFICATION_DATABASE_TLS=verify-full
# Supply CERTIFICATION_DATABASE_CA_PEM separately only if the approved provider requires it.
# Leave CERTIFICATION_ENROLLMENT_MANIFEST_JSON unset until the agreement/check are approved.
# Staged restoration requires a valid current manifest even with new submissions disabled.
# Never copy CERTIFICATION_TEST_* variables or disposable fixture credentials into production.
# Retention previews are library-only and have no activation flag in this template.
# See docs/restoration-configuration.md for scope and remaining release prerequisites.
