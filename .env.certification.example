# Reference template only; this filename is not automatically loaded by dotenv.
# Fill real values through approved hosting secret settings, never in Git or chat.
# The existing academy needs these four values even when certification is disabled.
DISCORD_TOKEN=
GUILD_ID=
VERIFIED_ROLE_ID=
DATABASE_URL=

# Keep both flags false for the initial reviewed deployment.
CERTIFICATION_ENABLED=false
CERTIFICATION_ENROLLMENT_SUBMISSION_ENABLED=false

# Set the explicit reviewed owner/channel before enabling certification.
ACADEMY_OWNER_ID=
ACADEMY_ADMIN_CHANNEL_ID=

# Required only when certification is enabled; no academy-URL fallback.
CERTIFICATION_DATABASE_URL=
CERTIFICATION_DATABASE_TLS=verify-full
# Supply CERTIFICATION_DATABASE_CA_PEM separately only if the approved provider requires it.
# Leave CERTIFICATION_ENROLLMENT_MANIFEST_JSON unset until the agreement/check are approved.
# Never set CERTIFICATION_TEST_DATABASE_URL or CERTIFICATION_TEST_ALLOW_ROLE_DDL on production.
